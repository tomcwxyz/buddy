# Buddy works without a model fallback. Local OCR, pronunciation/sound guidance,
# Datamuse and dictionary lookup remain available without these values.

# Optional: enables the tightly scoped word-explanation fallback.
# For child-facing deployments, do not enable this until the deployment's
# privacy/data-retention setup is appropriate for the intended users.
BUDDY_MODEL_FALLBACK_ENABLED=false

# Required only when BUDDY_MODEL_FALLBACK_ENABLED=true.
OPENAI_API_KEY=

# Optional override. Defaults to the cost-sensitive GPT-5.6 Luna model.
BUDDY_EXPLAIN_MODEL=gpt-5.6-luna
